  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "prisma generate && nest start --watch",
    "start": "prisma generate && nest start --watch",
    "start:dev": "prisma generate && nest start --watch",
    "start:debug": "prisma generate && nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "prisma:import-agencias": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/import-datos-agencias.ts",
    "prisma:import-informacion": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/import-informacion-sistema.ts",
    "prisma:import-ot": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/import-ot-xlsx.ts",
    "prisma:cifrar-imagenes": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/cifrar-imagenes.ts",
    "prisma:seed-demo": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/seed-demo-dashboards.ts",
    "prisma:seed-completo": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/seed-demo-completo.ts",
    "prisma:seed-tres-meses": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/seed-demo-tres-meses.ts",
    "prisma:seed-demo-aprobaciones": "node --require ./scripts/tsx-windows-userinfo.cjs --import tsx prisma/seed-demo-aprobaciones.ts",
    "prisma:studio": "prisma studio"
  },
