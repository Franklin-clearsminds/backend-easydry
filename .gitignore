# ==========================================
# EasyDry Backend - Git Ignore Rules
# ==========================================

# 1. Dependencias
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Compilación y Construcción
dist/
build/
*.tsbuildinfo
tsconfig.build.tsbuildinfo

# 3. Variables de Entorno y Secretos Sensibles
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 4. Bases de Datos Locales y Archivos Temporales
*.db
*.db-journal
*.sqlite
*.sqlite3

# 5. Archivos Multimedia y Uploads en Desarrollo
uploads/
storage/
temp/
tmp/

# 6. Registros y Logs
logs/
*.log

# 7. Pruebas y Cobertura
coverage/
.nyc_output/

# 8. Archivos de Sistema Operativo e IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
scratch/
