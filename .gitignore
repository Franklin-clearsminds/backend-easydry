# ==========================================
# EasyDry Backend - Git Ignore Rules
# ==========================================

# 1. Dependencias
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Compilación y Construcción
dist/
build/
*.tsbuildinfo
tsconfig.build.tsbuildinfo

# 3. Variables de Entorno y Secretos Sensibles
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 4. Bases de Datos Locales y Archivos Temporales
*.db
*.db-journal
*.sqlite
*.sqlite3

# 5. Archivos Multimedia y Uploads en Desarrollo
uploads/
# Ignorar solo almacenamiento generado en la raíz. El módulo Nest
# src/modules/storage contiene código fuente y debe versionarse.
/storage/
temp/
tmp/

# 6. Registros y Logs
logs/
*.log

# 7. Pruebas y Cobertura
coverage/
.nyc_output/

# 8. Archivos de Sistema Operativo e IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace
scratch/
.rtk/
CLAUDE.md

# 9. Archivos de Datos Temporales y Archivos Comprimidos
*.xlsx
*.zip
_tmp_*

# 10. Scripts Temporales de Prueba, Semillas y Diagnóstico
check-*.ts
fix-*.ts
test*.ts
seed-financial.ts

scripts/audit-*.cjs
scripts/check-*.cjs
scripts/inspect-*.cjs
scripts/list-*.cjs
scripts/seed-all-*.cjs
scripts/seed-aprobador-*.cjs
