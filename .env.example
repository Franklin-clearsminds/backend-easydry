# ==============================================================
# EasyDry® Backend — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y ajusta los valores correspondientes
# ==============================================================

# 1. Base de Datos Central (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easydry_db?schema=public"

# 2. Seguridad y Autenticación JWT
# EN PRODUCCIÓN (NODE_ENV="production") JWT_SECRET, JWT_REFRESH_SECRET y ENCRYPTION_KEY SON OBLIGATORIOS:
# el servidor no arranca sin ellos. Genera valores propios y distintos (por ejemplo: openssl rand -base64 48).
# Los valores de este archivo son solo de desarrollo.
JWT_SECRET="EasyDrySecretKey2026*OfflineSync"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="EasyDryRefreshSecretKey2026*OfflineSync"
JWT_REFRESH_EXPIRATION="15d"

# 3. Clave Secreta de Cifrado AES-256-CBC (Exactamente 32 bytes)
ENCRYPTION_KEY="EasyDrySecretKey2026*OfflineSync32B"

# 4. Configuración del Servidor NestJS
PORT=3000
NODE_ENV="development"

# 5. Seguridad de Acceso Web y Móvil (CORS)
CORS_ORIGIN="http://localhost:4200,http://localhost:5173,http://localhost:8081,http://localhost:19006,exp://"

# 6. Evidencias Multimedia Offline-First
MAX_FILE_SIZE_MB=35

# 7. Almacenamiento AWS S3 obligatorio (sin fallback local)
AWS_REGION="us-east-1"
# En AWS se recomienda usar un IAM Role y dejar vacías estas dos variables.
# En desarrollo local configure ambas; nunca configure solo una.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="easydry-storage-dev"
AWS_S3_PUBLIC_URL_PREFIX="https://easydry-storage-dev.s3.us-east-1.amazonaws.com"
# Opcional: solo para apuntar a un endpoint S3-compatible distinto de AWS (p.ej. MinIO en desarrollo).
# Vacío en AWS real. Se acepta AWS_ENDPOINT o AWS_S3_ENDPOINT (el primero que esté definido).
AWS_ENDPOINT=""

# 8. Seed (prisma/seed.ts) — cuentas Super Admin y Admin
# Las dos contraseñas son obligatorias (no hay valor por defecto) y se cambian en el primer ingreso.
SEED_SUPERADMIN_EMAIL="superadmin@easydry.com"
SEED_SUPERADMIN_PASSWORD=""
SEED_ADMIN_EMAIL="admin@easydry.com"
SEED_ADMIN_PASSWORD=""
# SEED_ACTUALIZAR_ROLES=SI   restablece los permisos de los roles oficiales a los de fábrica
# SEED_RESET=SI              VACÍA toda la base (en producción exige además SEED_CONFIRMAR_PRODUCCION=SI)

# 9. Importación del Excel (prisma/import-datos-agencias.ts)
# Contraseña inicial de los usuarios NUEVOS (mínimo 8 caracteres, obligatoria); cada uno debe cambiarla al entrar.
IMPORT_PASSWORD_INICIAL=""

# 10. Sesión web (cookie del refresh token) y proxy
# Detrás de un balanceador/nginx pon TRUST_PROXY=1 (cantidad de proxies) para que el límite de intentos use la IP real.
# TRUST_PROXY=1
# El refresh token del navegador va en una cookie HttpOnly. Si la web y la API están en dominios distintos (no "same-site"),
# usa COOKIE_SAMESITE=none (exige HTTPS). Con el mismo dominio principal deja el valor por defecto.
# COOKIE_SAMESITE=lax
# Swagger (/api/docs) queda apagado en producción salvo que lo actives a propósito.
# SWAGGER_ENABLED=false
