{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyEasyDryBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::easydry-storage-dev"
    },
    {
      "Sid": "ManageEasyDryEvidence",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::easydry-storage-dev/agencias/*"
    }
  ]
}
